{
  "name": "godot-mcp-bridge",
  "version": "1.1.6",
  "mcpName": "io.github.TomasLucasUTN/godot-mcp-bridge",
  "description": "MCP server for the Godot 4 editor — live-tree scene editing with undo, runtime game control, and 228 tools over MCP",
  "author": "Tomas Lucas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomasLucasUTN/godot-mcp-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/TomasLucasUTN/godot-mcp-bridge/issues"
  },
  "homepage": "https://github.com/TomasLucasUTN/godot-mcp-bridge#readme",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "godot-mcp-bridge": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "bundled-addon"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-visualizer.js && node scripts/bundle-addon.js",
    "build:visualizer": "node scripts/build-visualizer.js",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc && node scripts/build-visualizer.js && node dist/index.js",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle:addon": "node scripts/bundle-addon.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "godot",
    "godot4",
    "game-development",
    "gamedev",
    "ai-assistant",
    "claude",
    "cursor"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.18.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^4.1.4",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.4"
  }
}
